# Public — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret — server-only, bypasses RLS. NEVER prefix with NEXT_PUBLIC_.
# Only used inside app/api/scan/route.ts (the scan worker).
SUPABASE_SERVICE_ROLE_KEY=

# Secret — server-only. Vercel AI Gateway uses OIDC automatically on Vercel;
# set this only for local development when gateway authentication requires it.
AI_GATEWAY_API_KEY=
